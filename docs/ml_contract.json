{
  "model_name": "Provider Access Gap Classifier",
  "version": "v1.0-baseline",
  "inference_request_schema": {
    "zip_code": "string",
    "specialty": "string",
    "features": {
      "provider_density_per_10k": "float",
      "medicare_claims_per_provider": "float",
      "distance_to_nearest_provider_miles": "float"
    }
  },
  "inference_response_schema": {
    "access_gap_score": "float",
    "gap_category": "string",
    "recommendation": "string",
    "confidence": "float",
    "explanation": "list"
  }
}